[
    {
        "namespace": "sensordata",
        "type": "record",
        "name": "Metric",
        "fields":[
             {
                "name": "deviceId",
                "type": {
                    "type": "string",
                    "logicalType": "uuid"
                }
             },
             {
                "name": "timestamp",
                "type": {
                    "type": "long",
                    "logicalType": "timestamp-millis"
                }
             },
             {
                "name": "name", "type": "string"
             },
             {
                "name": "value", "type": "double"
             }
        ]
    },
    {
        "namespace": "sensordata",
        "type": "record",
        "name": "InvalidMetric",
        "fields":[
             {
                "name": "metric", "type": "sensordata.Metric"
             },
             {
                "name": "error", "type": "string"
             }
        ]
    }
]
